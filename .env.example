# Copy to .env and fill in. Never commit the filled-in .env.

# --- LLM ---
# Which provider adapter LLMSingleton plugs in (see model.py):
#   vertex_ai  Gemini on Google Cloud Vertex AI. Needs PROJECT_ID and
#              Application Default Credentials.
#   groq       Models served by Groq. Needs GROQ_API_KEY.
#   claude     Anthropic's Claude. Needs ANTHROPIC_API_KEY.
#   openai     OpenAI, or any OpenAI-compatible API (OpenRouter, DeepSeek,
#              Together, Ollama) via OPENAI_BASE_URL. Needs OPENAI_API_KEY.
#   gemini     Gemini on a Google AI Studio key: no Cloud project needed, and
#              there is a free tier. Needs GEMINI_API_KEY.
LLM_PROVIDER=vertex_ai
# Leave empty for the adapter's default: gemini-2.5-flash (vertex_ai, gemini),
# llama-3.3-70b-versatile, claude-opus-5-5, or gpt-5.
LLM_MODEL=
# Per-mode overrides. Modes: EXTRACTION, ENFORCEMENT, SYNTHESIS, GENERATION.
#   GENERATION   the writer
#   ENFORCEMENT  the judge that scores drafts against the Brand Brain
#   SYNTHESIS    writes the Brand Brain (runs rarely)
#   EXTRACTION   reads each uploaded document (high volume, checked in code)
#
# Any mode can run on its own provider. A mode moved to another provider
# ignores LLM_MODEL (a model of the shared provider) and takes
# LLM_MODEL_<MODE> or that provider's default. Example: a free model for
# extraction, a frontier writer, and a judge from a different model family,
# so it does not favour the writer's own habits:
# LLM_PROVIDER=groq
# LLM_PROVIDER_GENERATION=claude
# LLM_PROVIDER_SYNTHESIS=claude
# LLM_PROVIDER_ENFORCEMENT=gemini
# LLM_MODEL_ENFORCEMENT=gemini-2.5-pro
#
# LLM_MODEL_GENERATION=
# LLM_MAX_TOKENS_SYNTHESIS=16384
# LLM_TEMPERATURE_GENERATION=0.8
# Reasoning models count their thinking toward max tokens and take longer:
# LLM_MAX_TOKENS_GENERATION=16000
# LLM_TIMEOUT_GENERATION=240

# vertex_ai
PROJECT_ID=
LOCATION=us-central1
# Path to a service account JSON key with the Vertex AI User role. Leave unset
# to use Application Default Credentials (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=

# groq
GROQ_API_KEY=

# claude
ANTHROPIC_API_KEY=

# openai (or an OpenAI-compatible API; leave OPENAI_BASE_URL empty for OpenAI)
#   OpenRouter https://openrouter.ai/api/v1   DeepSeek https://api.deepseek.com
#   Ollama     http://localhost:11434/v1 (set OPENAI_API_KEY to any value)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Embeddings (retrieval over uploaded product documents) ---
# Which embeddings adapter EmbeddingSingleton plugs in (see embedding_stategy.py).
# Groq and Claude have no embedding models, so when this is empty each LLM
# provider uses its pairing:
#   vertex_ai  Vertex text-embedding-004 (768d). Uses PROJECT_ID above.
#   voyage     Voyage AI voyage-4 (1024d), Anthropic's recommended partner.
#              Default for LLM_PROVIDER=claude. Needs VOYAGE_API_KEY.
#   local      BAAI/bge-small-en-v1.5 (384d) run in-process, no API key.
#              Default for LLM_PROVIDER=groq. Downloads ~70MB on first use.
# Changing backend changes the vector size, so re-upload product documents.
EMBEDDING_PROVIDER=
# Leave empty for the adapter's default model.
EMBEDDING_MODEL=
# Voyage only: 256, 512 or 1024.
EMBEDDING_DIMENSIONS=
VOYAGE_API_KEY=

# --- Web search: Parallel Search API ---
PARALLEL_API_KEY=

# --- Database ---
POSTGRES_URI=postgresql://brandmaestro:changeme@postgres:5432/brandmaestro
POSTGRES_USER=brandmaestro
POSTGRES_PASSWORD=changeme
POSTGRES_DB=brandmaestro

# --- Cache / queue ---
REDIS_URL=redis://redis:6379/0
# Celery broker. Defaults to REDIS_URL, so Redis brokers the queues as well as
# holding the Brand Brain cache, the result backend and the generation stream.
# One less service to run, which matters on hosts with no managed RabbitMQ.
# Set this to an amqp:// URL to use RabbitMQ instead; nothing else changes.
CELERY_BROKER_URL=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Celery monitoring (Flower) ---
FLOWER_USER=admin
FLOWER_PASSWORD=changeme

# --- Frontend ---
# Origin allowed by CORS, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
# --- Optional: Opik tracing (observability.py) ---
# Leave OPIK_API_KEY empty to disable tracing entirely (fails open, no
# behavior change). Get a key at https://www.comet.com/opik — free tier.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=brandmaestro-ai

# --- Optional: LLM request timeout / retry tuning (model.py) ---
# Defaults are 60s / 90s (synthesis) per attempt, 2 retries. Raise them for
# slower models (e.g. reasoning models) if legitimate calls are being cut off.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_SYNTHESIS_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Writer/Enforcer revision rounds. Each round is two LLM calls, so this is the
# main latency lever.
#
# The default of 3 is not enough for every content type: long-form pieces
# have approved on round 5. Raise it if generations are ending unapproved with
# actionable feedback still outstanding, and leave it alone if they are failing
# repeatedly for the same reason — that is not a round-count problem.
MAX_REVISION_ITERATIONS=6

# How long a client may watch a generation stream before the server gives up.
# Long-form content can run several enforcer rounds; 300 cut it off
# mid-pipeline.
MAX_STREAM_SECONDS=900

# --- Optional: YouTube Automation (docs/youtube-automation.md) ---
# Not needed for marketing; the app starts without any of these.
# Where videos, images and audio are stored: local | gcs.
# Defaults to gcs when YT_GCS_BUCKET is set, otherwise local.
YT_STORAGE_PROVIDER=
YT_GCS_BUCKET=
# Directory for local storage (development only).
YT_LOCAL_STORAGE_PATH=.yt_storage

# Voices for characters: kokoro (local, free) | google_tts (Google Cloud TTS).
YT_VOICE_PROVIDER=kokoro
# Kokoro downloads its model (~330 MB) here on first use.
YT_KOKORO_MODEL_DIR=.cache/kokoro
# kokoro-v1.0.onnx (default) or kokoro-v1.0.int8.onnx. The int8 build is smaller
# but was about 10x slower on an older CPU without VNNI.
YT_KOKORO_MODEL=
# All-capitals words to say as a word, not spell out letter by letter (RAG, NASA and
# a few others already are), comma-separated, e.g. ACME,FINTRAK
YT_SAID_AS_WORDS=
# Google Cloud TTS: which language's voices to list, and optionally a price so
# usage is costed (USD per million characters for the voices you use).
YT_GOOGLE_TTS_LANGUAGE=en-US
YT_GOOGLE_TTS_USD_PER_MILLION_CHARS=

# Character sheets and storyboard images: nano_banana (Gemini 3.1 Flash Image on
# Vertex, uses PROJECT_ID above) | seedream (ByteDance Seedream 4 via fal.ai, FAL_KEY) |
# seedream_wavespeed (the same Seedream 4 via WaveSpeed, WAVESPEED_API_KEY below).
YT_IMAGE_PROVIDER=nano_banana
YT_IMAGE_MODEL=gemini-3.1-flash-image
YT_IMAGE_LOCATION=global
# Nano Banana: 1K | 2K | 4K, larger sizes cost more per image.
# seedream_wavespeed: 1K | 2K, same price at both; leave empty for 2K.
YT_IMAGE_SIZE=1K
# Price per image used for cost records, if your billing differs from the default.
YT_IMAGE_USD=
# How many times to wait and retry after a rate limit (15s, 30s, then 60s waits).
YT_IMAGE_MAX_RETRIES=5
# Automatic check of each storyboard image: auto (Gemini with Nano Banana, else
# borders only) | gemini | basic | off. A flagged image is redrawn this many times.
YT_IMAGE_CHECK=auto
YT_IMAGE_CHECK_RETRIES=1
YT_IMAGE_CHECK_MODEL=gemini-2.5-flash
# fal.ai API key, for YT_IMAGE_PROVIDER=seedream and YT_AVATAR_PROVIDER=kling_standard.
FAL_KEY=

# Talking characters in dialogue shots: still (no lip sync, free) |
# kling_standard (Kling AI Avatar v2 Standard via fal.ai, FAL_KEY) |
# infinitetalk (InfiniteTalk via WaveSpeed, WAVESPEED_API_KEY).
YT_AVATAR_PROVIDER=still
WAVESPEED_API_KEY=
# 480p ($0.03/s) | 720p ($0.06/s)
YT_INFINITETALK_RESOLUTION=480p
# Most seconds of each line that are animated; the rest plays over the still image.
YT_MAX_TALKING_SECONDS=6
# A render whose new avatar clips would cost more than this needs confirming.
YT_AVATAR_BUDGET_USD=5
# How long to wait for one avatar clip, in seconds.
YT_AVATAR_TIMEOUT_S=900

# Rendering (worker_render). ffmpeg is found on PATH unless YT_FFMPEG is set.
YT_FFMPEG=
# Render at a fraction of full size (e.g. 0.5) for quick drafts.
YT_RENDER_SCALE=1
YT_RENDER_FPS=30
YT_RENDER_PRESET=veryfast
# Renders kept per project; older videos are deleted.
YT_KEEP_RENDERS=3
YT_CAPTION_FONT=DejaVu Sans
YT_CAPTION_MAX_WORDS=5

# Generated ambience under each shot: off | elevenlabs (text to sound effects).
# Music tracks are uploaded as assets and work without this.
YT_SOUND_PROVIDER=off
ELEVENLABS_API_KEY=
# Price per generated ambience clip, for cost records.
YT_SOUND_USD_PER_CLIP=

# Publishing to YouTube. Create an OAuth client of type "Web application" in the
# Google Cloud project, with YouTube Data API v3 enabled and the consent screen
# "In production" (in "Testing", the sign-in expires after 7 days). Until the
# project passes YouTube's API audit, uploaded videos are locked private.
YT_GOOGLE_CLIENT_ID=
YT_GOOGLE_CLIENT_SECRET=
# The redirect URI registered on that client, e.g. https://your-domain/youtube/channel/callback
YT_OAUTH_REDIRECT_URI=
# Fernet key for the stored refresh token. If empty, one is derived from SECRET_KEY
# (changing SECRET_KEY then means connecting the channel again).
YT_TOKEN_KEY=
# Daily YouTube quota, if your project was granted more than the defaults.
YT_DAILY_UPLOADS=100
YT_DAILY_QUOTA_UNITS=10000
YT_UPLOAD_CHUNK_MB=8
# YouTube category for new videos (24 Entertainment, 1 Film & Animation, 22 People & Blogs)
YT_DEFAULT_CATEGORY=24
YT_VIDEO_LANGUAGE=en
